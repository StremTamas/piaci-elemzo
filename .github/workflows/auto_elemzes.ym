name: Automatikus Piacelemzo

on:
  schedule:
    # Magyar ido (CET) szerint 08:00, 12:00, 16:00 es 20:00 orakor fut
    - cron: '0 7,11,15,19 * * *'
  workflow_dispatch:

jobs:
  run-analyzer:
    runs-on: ubuntu-latest
    steps:
      - name: Kod letoltese
        uses: actions/checkout@v4

      - name: Python beallitasa
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Csomagok telepitese
        run: |
          pip install --upgrade pip
          pip install -r requirements.txt

      - name: Streamlit Secrets letrehozasa
        env:
          SECRETS_CONTENT: ${{ secrets.STREAMLIT_SECRETS }}
        run: |
          mkdir -p .streamlit
          printf "%s\n" "$SECRETS_CONTENT" > .streamlit/secrets.toml

      - name: Elemzes futtatasa
        run: python market_analyzer.py
